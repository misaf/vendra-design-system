{
  // Type-checks the shared storefront logic as plain JavaScript; nothing is emitted.
  // The _shared/ files are ES modules that import one another.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["_shared/**/*.js", "_types/*.d.ts"]
}
