{
  "name": "vendra-storefront-templates",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.components.json && tsc -p tsconfig.package.json",
    "build": "node _build/build.cjs",
    "check": "node _build/build.cjs --check && prettier --ignore-path ../.prettierignore --check ../components . && npm run lint:css",
    "test": "npm run typecheck && node _tests/storefront.test.cjs && node _tests/presentation.test.cjs && node _tests/assets.test.cjs && node _tests/migration.test.cjs && node _tests/tenants.test.cjs && node _tests/components.test.cjs && node _tests/features.test.cjs && node _tests/package.test.cjs && node _tests/size.test.mjs && node _tests/api-contract.test.cjs && node _tests/spatial.test.mjs",
    "test:react19": "node _tests/react-19.cjs",
    "dev": "vite --config _build/vite.config.mjs",
    "build:app": "npm run build && vite build --config _build/vite.config.mjs",
    "preview": "vite preview --config _build/vite.config.mjs",
    "test:e2e:build": "E2E_TARGET=build playwright test -c _e2e/playwright.config.mjs",
    "test:e2e": "playwright test -c _e2e/playwright.config.mjs",
    "test:e2e:update": "playwright test -c _e2e/playwright.config.mjs --update-snapshots",
    "test:e2e:remote": "node _e2e/remote.mjs",
    "format": "prettier --ignore-path ../.prettierignore --write ../components .",
    "lint:css": "stylelint \"../components/**/*.css\" \"_shared/*.css\" \"storefront-*/*.css\"",
    "new:component": "node _build/new-component.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "18.3.31",
    "prettier": "3.9.10",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rolldown": "1.2.13",
    "stylelint": "17.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "react-aria-components": "1.22.1"
  }
}
