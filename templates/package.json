{
  "name": "vendra-storefront-templates",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.components.json",
    "build": "node _build/build.cjs",
    "check": "node _build/build.cjs --check",
    "test": "npm run typecheck && node _tests/storefront.test.cjs && node _tests/generation.test.cjs && node _tests/bundle.test.cjs && node _tests/assets.test.cjs && node _tests/migration.test.cjs && node _tests/tenants.test.cjs && node _tests/components.test.cjs && node _tests/features.test.cjs",
    "dev": "vite --config _build/vite.config.mjs",
    "test:e2e": "playwright test -c _e2e/playwright.config.mjs",
    "test:e2e:update": "playwright test -c _e2e/playwright.config.mjs --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "18.3.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
