{
  "name": "vendra-storefront-templates",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.components.json && tsc -p tsconfig.package.json",
    "build": "node _build/build.cjs",
    "check": "node _build/build.cjs --check && prettier --ignore-path ../.prettierignore --check ../components .",
    "test": "npm run typecheck && node _tests/storefront.test.cjs && node _tests/assets.test.cjs && node _tests/migration.test.cjs && node _tests/tenants.test.cjs && node _tests/components.test.cjs && node _tests/features.test.cjs && node _tests/package.test.cjs && node _tests/size.test.mjs && node _tests/api-contract.test.cjs",
    "test:react19": "node _tests/react-19.cjs",
    "dev": "vite --config _build/vite.config.mjs",
    "build:app": "npm run build && vite build --config _build/vite.config.mjs",
    "preview": "vite preview --config _build/vite.config.mjs",
    "test:e2e:build": "E2E_TARGET=build playwright test -c _e2e/playwright.config.mjs",
    "test:e2e": "playwright test -c _e2e/playwright.config.mjs",
    "test:e2e:update": "playwright test -c _e2e/playwright.config.mjs --update-snapshots",
    "format": "prettier --ignore-path ../.prettierignore --write ../components ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "18.3.31",
    "prettier": "3.9.9",
    "rolldown": "1.2.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "react-aria-components": "1.21.1"
  }
}
