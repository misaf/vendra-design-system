  "tracking": {
    "display": {
      "$type": "dimension",
      "$value": ".02em"
    },
    "button": {
      "$type": "dimension",
      "$value": ".12em"
    }
  },
  "display": {
    "case": {
      "$value": "uppercase"
    }
