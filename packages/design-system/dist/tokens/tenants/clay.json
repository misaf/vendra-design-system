  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(31,29,24,.06)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(31,29,24,.18)",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "20px",
        "spread": "-8px"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(31,29,24,.28)",
        "offsetX": "0px",
        "offsetY": "24px",
        "blur": "48px",
        "spread": "-16px"
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Jost",
        "Jost Fallback",
        "Vazirmatn",
        "Vazirmatn Fallback",
        "Vazirmatn Fallback Naskh",
        "Vazirmatn Fallback Sans",
        "Vazirmatn Fallback Free",
        "Segoe UI",
        "Tahoma",
        "system-ui",
        "sans-serif"
      ]
    }
