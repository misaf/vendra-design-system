{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "components/utils/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Jost|Vazirmatn))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Jost, Vazirmatn."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|content|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: id, title, content."
      },
      {
        "selector": "JSXOpeningElement[name.name='AddressCardLabels'] > JSXAttribute > JSXIdentifier[name!=/^(?:edit|delete|default|makeDefault|key|ref|className|style|children)$/]",
        "message": "<AddressCardLabels> doesn't accept that prop. Declared props: edit, delete, default, makeDefault."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|title|children|action|onClose|closeLabel|className|style|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, icon, title, children, action, onClose, closeLabel, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|warning|danger|success)$/]",
        "message": "<Alert> tone must be one of 'neutral' | 'warning' | 'danger' | 'success'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnnouncementBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClose|closeLabel|label|className|key|ref|className|style|children)$/]",
        "message": "<AnnouncementBar> doesn't accept that prop. Declared props: children, onClose, closeLabel, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArchFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|srcSet|sizes|alt|ratio|minHeight|tone|size|shape|placeholder|placeholderLabel|ring|zoomOnHover|objectPosition|children|key|ref|className|style|children)$/]",
        "message": "<ArchFrame> doesn't accept that prop. Declared props: src, srcSet, sizes, alt, ratio, minHeight, tone, size, shape, placeholder, placeholderLabel, ring, zoomOnHover, objectPosition, children."
      },
      {
