  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(20,32,42,.06)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(20,32,42,.18)",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "20px",
        "spread": "-8px"
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "color": "rgba(20,32,42,.28)",
        "offsetX": "0px",
        "offsetY": "24px",
        "blur": "48px",
        "spread": "-16px"
      }
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Vazirmatn",
        "Vazirmatn Fallback",
        "Vazirmatn Fallback Naskh",
        "Vazirmatn Fallback Sans",
        "Vazirmatn Fallback Free",
        "Segoe UI",
        "Tahoma",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "tracking": {
    "display": {
      "$type": "dimension",
      "$value": "-.01em"
    },
    "button": {
      "$type": "dimension",
      "$value": ".02em"
    }
  },
  "display": {
    "case": {
      "$value": "none"
    }
  },
  "radius": {
    "control": {
      "$value": "{radius.pill}"
    },
    "arch": {
      "$value": "24px 24px {radius.md} {radius.md}"
    }
  },
  "button": {
    "case": {
      "$value": "none"
    }
  }
