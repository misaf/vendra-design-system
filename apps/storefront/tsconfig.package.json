{
  // Strict check of the published declarations (dist/**/*.d.ts), as an app's compiler sees them.
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": [],
    // The React types the workspace installs at the repo root.
    "paths": {"react": ["../../node_modules/@types/react/index.d.ts"]}
  },
  "include": [
    "../../packages/design-system/dist/**/*.d.ts",
    "../../packages/design-system/dist/**/*.d.cts"
  ]
}
