{
  // Type-checks the storefront app, pages and shared logic as plain JavaScript and JSX; nothing is
  // emitted. Unused imports and variables are errors.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "types": ["vite/client"],
    "noUnusedLocals": true,
    "skipLibCheck": true
  },
  "include": ["_shared/**/*.js", "_types/*.d.ts", "app/**/*", "storefront-*/**/*"]
}
