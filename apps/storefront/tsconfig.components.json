{
  // Strict check of the hand-written component declarations (components/**/*.d.ts).
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["react"]
  },
  "include": [
    "design-system/components/**/*.d.ts",
    "shared/domain/commerce.d.ts",
    "../../packages/ui/**/*.d.ts",
    "tests/fixtures/component-types.tsx",
    "tests/fixtures/theme-types.mts"
  ]
}
