{
  "name": "vendra-florist",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.storefront.json",
    "generate": "node tools/build/build.mjs",
    "check": "npm run generate -- --check && prettier --check tools src e2e tests *.mjs *.json && npm run lint && npm run lint:css",
    "test": "npm run typecheck && node --test \"tests/*.test.mjs\" \"src/storefront/**/*.test.mjs\"",
    "dev": "npm run generate && node tools/next/prepare-assets.mjs && next dev",
    "dev:gallery": "npm run generate && node tools/next/prepare-assets.mjs && node tools/next/prepare-fixtures.mjs && next dev",
    "build": "npm run generate && node tools/next/prepare-assets.mjs && next build",
    "start": "next start",
    "build:demo": "npm run generate && node tools/next/prepare-assets.mjs && VF_NEXT_EXPORT=1 next build && node tools/next/finish-export.mjs",
    "preview:demo": "node tools/next/serve-export.mjs",
    "test:e2e:dev": "E2E_TARGET=dev playwright test -c e2e/playwright.config.mjs",
    "test:e2e:demo": "E2E_TARGET=build playwright test -c e2e/playwright.config.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:update": "node e2e/run.mjs --update-snapshots",
    "format": "prettier --write tools src e2e tests *.mjs *.json",
    "lint": "eslint src/app \"src/platform/server/**/*.{mjs,ts}\" \"src/storefront/catalog/laravel/*.{js,mjs,ts}\" \"src/storefront/catalog/product/components/StorefrontProductHeading/*.{jsx,tsx}\" src/storefront/catalog/product/ProductScreen.jsx \"src/storefront/checkout/order-checkout/{submission-state,submit-order}.js\" \"src/platform/browser/**/*.js\" src/storefront/customer/account \"src/storefront/presentation/{browsing-viewer,camera-scanner,display-rotation,presentation-settings}.js\" \"src/storefront/shell/{consent,navigation,shell-props}.js\" \"src/design-system/components/{Button,Dialog,Input,QuantityInput,Select}/**/*.{js,jsx,mjs,ts,tsx}\"",
    "lint:css": "stylelint \"src/design-system/components/**/*.css\" \"src/storefront/**/*.css\" \"src/app/**/*.css\"",
    "new:component": "node tools/new-component.mjs",
    "test:smoke:demo": "playwright test -c e2e/smoke/playwright.config.mjs",
    "test:smoke:app": "VF_TEST_LIVE=1 playwright test -c e2e/smoke/playwright.config.mjs",
    "test:smoke:catalog": "VF_TEST_LIVE=catalog playwright test -c e2e/smoke/playwright.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "rolldown": "1.3.0",
    "stylelint": "18.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "description": "Vendra Next.js storefront and its design system.",
  "license": "MIT"
}
