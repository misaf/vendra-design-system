{
  "name": "vendra-florist",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.storefront.json",
    "build": "node tools/build/build.mjs",
    "check": "node tools/build/build.mjs --check && prettier --check tools src e2e tests *.mjs *.json && npm run lint:css",
    "test": "npm run typecheck && node --test \"tests/*.test.mjs\" \"src/storefront/**/*.test.mjs\"",
    "dev": "npm run dev:next --",
    "build:app": "npm run build:live",
    "preview": "npm run start:live --",
    "test:e2e:dev": "E2E_TARGET=dev playwright test -c e2e/playwright.config.mjs",
    "test:e2e:build": "E2E_TARGET=build playwright test -c e2e/playwright.config.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:update": "node e2e/run.mjs --update-snapshots",
    "test:e2e:remote": "node e2e/remote.mjs",
    "format": "prettier --write tools src e2e tests *.mjs *.json",
    "lint:css": "stylelint \"src/design-system/components/**/*.css\" \"src/storefront/**/*.css\" \"src/app/**/*.css\"",
    "new:component": "node tools/new-component.mjs",
    "dev:next": "npm run build && node tools/next/prepare-assets.mjs && node tools/next/prepare-fixtures.mjs && next dev",
    "build:next": "npm run build && node tools/next/prepare-assets.mjs && VF_NEXT_EXPORT=1 next build && node tools/next/finish-export.mjs",
    "start:next": "node tools/next/serve-export.mjs",
    "test:e2e:next": "playwright test -c e2e/smoke/playwright.config.mjs",
    "build:live": "npm run build && node tools/next/prepare-assets.mjs && next build",
    "start:live": "next start",
    "test:e2e:live": "VF_TEST_LIVE=1 npm run test:e2e:next",
    "build:demo": "npm run build:next",
    "preview:demo": "npm run start:next --"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "rolldown": "1.3.0",
    "stylelint": "18.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "next": "16.4.6",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "description": "Vendra Next.js storefront and its design system.",
  "license": "UNLICENSED",
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
