{
  "name": "vendra-design-system-workspace",
  "private": true,
  "description": "Workspace root: the @vendra/design-system package (packages/design-system) and the sample storefront (apps/storefront).",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/storefront run dev",
    "build": "npm --prefix apps/storefront run build",
    "check": "npm --prefix apps/storefront run check",
    "test": "npm --prefix apps/storefront test",
    "test:e2e": "npm --prefix apps/storefront run test:e2e --",
    "new:component": "npm --prefix apps/storefront run new:component --"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
