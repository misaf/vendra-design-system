{
  // Strict checks for TypeScript, design-system declarations, and the Laravel adapter.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["next", "next/image-types/global", "node", "react", "react-dom"],
    "incremental": true,
    "tsBuildInfoFile": ".next-types.tsbuildinfo",
    "plugins": [{"name": "next"}],
    "paths": {"@storefront/*": ["./*"]}
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/platform/server/laravel/**/*.mjs",
    "tests/fixtures/component-types.tsx",
    "tests/fixtures/theme-types.mts"
  ],
  "exclude": ["node_modules"]
}
