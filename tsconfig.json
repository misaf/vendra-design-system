{
  // Type-checks the storefront app, pages and shared logic as plain JavaScript and JSX; nothing is
  // emitted. Unused imports and variables are errors.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "types": ["react"],
    "noUnusedLocals": true,
    "skipLibCheck": true
  },
  "include": ["src/storefront/**/*", "src/platform/browser/**/*", "src/platform/tenant/**/*"],
  // Browser specs run in Node under Playwright.
  "exclude": ["src/platform/browser/vendor/**", "**/*.spec.mjs", "**/*.test.mjs"]
}
